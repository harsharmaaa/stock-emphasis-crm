generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  EMPLOYEE
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(EMPLOYEE)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Optional Team membership
  teamId       String?
  team         Team?    @relation("TeamMembers", fields: [teamId], references: [id], onDelete: SetNull)

  // Teams this user leads (Manager as Team Lead)
  ledTeams     Team[]   @relation("TeamLeader")

  // Hierarchical reporting (Employee -> Manager)
  managerId    String?
  manager      User?    @relation("ManagerSubordinates", fields: [managerId], references: [id], onDelete: SetNull)
  subordinates User[]   @relation("ManagerSubordinates")

  // Audit activity relations
  actionsPerformed ActivityLog[] @relation("ActorActivities")
  actionsReceived  ActivityLog[] @relation("TargetUserActivities")

  // Lead relations
  assignedLeads    Lead[]        @relation("AssignedLeads")
  createdLeads     Lead[]        @relation("CreatedLeads")

  // Employee details
  username          String?   @unique
  mobile            String?
  fatherName        String?
  state             String?
  city              String?
  dob               DateTime?
  address           String?
  joiningDate       DateTime?
  pastExperience    String?
  callingExtension  String?
  description       String?
  employeeTarget    Int?      @default(0)
  photo             String?

  // Department & Profile relationships
  departmentId      String?
  department        Department?      @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  employeeProfileId String?
  employeeProfile   EmployeeProfile? @relation(fields: [employeeProfileId], references: [id], onDelete: SetNull)

  // Lead Fetch Permissions
  leadFetchPermissions LeadFetchPermission[] @relation("UserLeadFetchPermissions")
  leadFetchSources     String[]              @default([])

  // Fetch Limit Management
  createdFetchLimitRules  FetchLimitRule[]     @relation("FetchLimitRuleCreatedBy")
  assignedFetchLimitRules FetchLimitRule[]     @relation("FetchLimitRuleAssignedUsers")
  fetchUsages             EmployeeFetchUsage[]
  leadFetchLogs           LeadFetchLog[]       @relation("UserLeadFetchLogs")

  // Soft delete
  deletedAt         DateTime?

  @@index([deletedAt])
  @@index([departmentId])
  @@index([employeeProfileId])
  @@index([username])
}

model Team {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?

  // Team Lead (Manager)
  leaderId    String?
  leader      User?    @relation("TeamLeader", fields: [leaderId], references: [id], onDelete: SetNull)

  // Team Members (Employees)
  members     User[]   @relation("TeamMembers")

  // Team leads
  leads       Lead[]

  // Team audit logs
  activities  ActivityLog[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([leaderId])
}

model ActivityLog {
  id           String   @id @default(cuid())
  action       String
  details      String?

  // Actor who performed the action
  actorId      String?
  actor        User?    @relation("ActorActivities", fields: [actorId], references: [id], onDelete: SetNull)

  // Target User affected
  targetUserId String?
  targetUser   User?    @relation("TargetUserActivities", fields: [targetUserId], references: [id], onDelete: SetNull)

  // Target Team affected
  targetTeamId String?
  targetTeam   Team?    @relation(fields: [targetTeamId], references: [id], onDelete: SetNull)

  ipAddress    String?
  createdAt    DateTime @default(now())

  @@index([actorId])
  @@index([targetUserId])
  @@index([targetTeamId])
  @@index([createdAt])
}

model SystemSetting {
  key         String   @id
  value       String
  category    String   @default("GENERAL")
  description String?
  updatedAt   DateTime @updatedAt
}

model Lead {
  id              String    @id @default(cuid())
  name            String
  mobile          String    @unique
  email           String?
  district        String?
  alternateMobile String?
  dob             DateTime?
  aadhar          String?
  fatherName      String?
  state           String?
  city            String?
  pan             String?
  gstin           String?
  occupation      String?
  segment         String?
  investment      String?
  profile         String?
  leadResponse    String?
  leadSource      String?   @default("DIRECT")
  description     String?
  experience      String?
  status          String    @default("UNFOLLOWED")
  callbackDate    DateTime?

  // Allotment / Assignment
  allotToId       String?
  allotTo         User?     @relation("AssignedLeads", fields: [allotToId], references: [id], onDelete: SetNull)

  // Associated Team
  teamId          String?
  team            Team?     @relation(fields: [teamId], references: [id], onDelete: SetNull)

  // Audit
  createdById     String?
  createdBy       User?     @relation("CreatedLeads", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([mobile])
  @@index([status])
  @@index([allotToId])
  @@index([teamId])
  @@index([callbackDate])
  @@index([createdAt])
}

model Department {
  id        String            @id @default(cuid())
  name      String            @unique
  isActive  Boolean           @default(true)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  profiles  EmployeeProfile[]
  users     User[]

  @@index([name])
}

model EmployeeProfile {
  id           String      @id @default(cuid())
  name         String      @unique
  departmentId String
  department   Department  @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  clientLimit  Int         @default(0)
  invoiceLimit Int         @default(0)
  salesLimit   Int         @default(0)
  description  String?
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  users        User[]
  fetchLimitRules FetchLimitRule[] @relation("FetchLimitRuleProfiles")

  @@index([departmentId])
  @@index([name])
}

model LeadFetchPermission {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation("UserLeadFetchPermissions", fields: [userId], references: [id], onDelete: Cascade)
  leadSource String
  createdAt  DateTime @default(now())

  @@unique([userId, leadSource])
  @@index([userId])
  @@index([leadSource])
}

model FetchLimitRule {
  id              String            @id @default(cuid())
  availableLimit  Int
  fetchLimit      Int
  fetchCount      Int               // configured maximum successful requests
  leadSource      String

  createdById     String
  createdBy       User              @relation("FetchLimitRuleCreatedBy", fields: [createdById], references: [id])

  profiles        EmployeeProfile[] @relation("FetchLimitRuleProfiles")
  assignedUsers   User[]            @relation("FetchLimitRuleAssignedUsers")

  usages          EmployeeFetchUsage[]
  fetchLogs       LeadFetchLog[]

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([leadSource])
  @@index([createdById])
}

model EmployeeFetchUsage {
  id                String          @id @default(cuid())
  userId            String
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  ruleId            String
  rule              FetchLimitRule  @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  leadSource        String
  successfulFetches Int             @default(0) // actual number of successful fetch requests used
  lastFetchedAt     DateTime?
  resetAt           DateTime?
  resetById         String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([userId, ruleId])
  @@index([userId, leadSource])
  @@index([ruleId])
}

model LeadFetchLog {
  id             String          @id @default(cuid())
  userId         String
  user           User            @relation("UserLeadFetchLogs", fields: [userId], references: [id], onDelete: Cascade)
  ruleId         String?
  rule           FetchLimitRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  leadSource     String
  appliedProfile String?         // Name of the winning profile applied (e.g. 'FM', 'AFM', etc.)
  leadsCount     Int             // Number of leads allocated in this request
  requestNumber  Int             // The sequence number of this successful request for this employee & rule (e.g. 1st, 2nd, ...)
  leadIds        String[]        @default([]) // IDs of leads allocated in this request
  createdAt      DateTime        @default(now())

  @@index([userId, leadSource])
  @@index([ruleId])
  @@index([createdAt])
}
